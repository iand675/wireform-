cabal-version: 3.0
name: wireform-lattice
version: 0.1.0.0
synopsis: Lattice, a cache-native graph query protocol: schema, planner, server, client
description:
  An implementation of the Lattice protocol (a cache-native, content-addressed
  graph query and mutation protocol in the GraphQL/JSON:API problem space).
  Provides the schema IDL parser and semantic model, the query language parser
  and canonicalizer, the authorization path-join planner, the NDJSON entity
  stream wire format, an HTTP origin built on wireform-http, and an HTTP client
  with a normalized entity store. The protocol specification lives in the
  wireform docs site under /lattice/.
license: BSD-3-Clause
license-file: LICENSE
author: Ian Duncan
maintainer: ian@iankduncan.com
category: Network
build-type: Simple

common defaults
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    RecordWildCards
    StrictData
  ghc-options: -Wall -Wcompat -Widentities -Wredundant-constraints

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Lattice
    Lattice.Backend
    Lattice.Backend.Memory
    Lattice.Canonical
    Lattice.Client
    Lattice.Client.Store
    Lattice.Compress
    Lattice.Cursor
    Lattice.Hash
    Lattice.IDL.Parser
    Lattice.IDL.Print
    Lattice.Plan
    Lattice.Query.AST
    Lattice.Query.Parser
    Lattice.Query.Validate
    Lattice.Schema
    Lattice.Server
    Lattice.Server.Auth
    Lattice.Server.Execute
    Lattice.Types
    Lattice.Value
    Lattice.Wire
  build-depends:
    aeson >= 2.1 && < 2.3,
    base >= 4.16 && < 5,
    base64-bytestring >= 1.2 && < 1.3,
    blake3 >= 0.3 && < 0.4,
    bytestring >= 0.11 && < 0.13,
    case-insensitive >= 1.2 && < 1.3,
    containers >= 0.6 && < 0.9,
    crypton >= 1.0 && < 1.2,
    memory >= 0.18 && < 0.19,
    scientific >= 0.3 && < 0.4,
    stm >= 2.5 && < 2.6,
    text >= 2.0 && < 2.2,
    time >= 1.12 && < 1.15,
    vector >= 0.13 && < 0.14,
    wireform-http,
    zlib >= 0.6 && < 0.8

executable example-lattice
  import: defaults
  hs-source-dirs: example
  main-is: Main.hs
  other-modules: StarWars
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    stm,
    text,
    time,
    wireform-http,
    wireform-lattice

test-suite wireform-lattice-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Test.Lattice.Canonical
    Test.Lattice.Compress
    Test.Lattice.Cursor
    Test.Lattice.E2E
    Test.Lattice.Fixtures
    Test.Lattice.IDL
    Test.Lattice.Plan
    Test.Lattice.Query
    Test.Lattice.Value
    Test.Lattice.Wire
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    hedgehog >= 1.0 && < 1.8,
    network,
    scientific,
    stm,
    sydtest,
    sydtest-hedgehog,
    text,
    time,
    wireform-http,
    wireform-lattice
