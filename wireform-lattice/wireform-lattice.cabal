cabal-version: 3.0
name: wireform-lattice
version: 0.1.0.0
synopsis: Lattice, a cache-native graph query protocol: schema, planner, server, client
description:
  An implementation of the Lattice protocol (a cache-native, content-addressed
  graph query and mutation protocol in the GraphQL/JSON:API problem space).
  Provides the schema IDL parser and semantic model, the query language parser
  and canonicalizer, the authorization path-join planner, the NDJSON entity
  stream wire format, an HTTP origin built on wireform-http, and an HTTP client
  with a normalized entity store. The protocol specification lives in the
  wireform docs site under /lattice/.
license: BSD-3-Clause
license-file: LICENSE
author: Ian Duncan
maintainer: ian@iankduncan.com
category: Network
build-type: Simple

common defaults
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    RecordWildCards
    StrictData
  ghc-options: -Wall -Wcompat -Widentities -Wredundant-constraints

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Lattice
    Lattice.Backend
    Lattice.Backend.Memory
    Lattice.Canonical
    Lattice.Client
    Lattice.Client.Store
    Lattice.Compat
    Lattice.Compress
    Lattice.Cursor
    Lattice.Digest
    Lattice.Hash
    Lattice.Gateway
    Lattice.IDL.Parser
    Lattice.IDL.Print
    Lattice.Module
    Lattice.Plan
    Lattice.Query.AST
    Lattice.Query.Parser
    Lattice.Query.Validate
    Lattice.Registry
    Lattice.Schema
    Lattice.Server
    Lattice.Server.Auth
    Lattice.Server.Coalesce
    Lattice.Server.Execute
    Lattice.Server.Live
    Lattice.TH
    Lattice.Telemetry
    Lattice.Typed
    Lattice.Types
    Lattice.Value
    Lattice.Wire
  build-depends:
    aeson >= 2.1 && < 2.3,
    base >= 4.16 && < 5,
    base64-bytestring >= 1.2 && < 1.3,
    blake3 >= 0.3 && < 0.4,
    bytestring >= 0.11 && < 0.13,
    case-insensitive >= 1.2 && < 1.3,
    containers >= 0.6 && < 0.9,
    crypton >= 1.0 && < 1.2,
    hs-opentelemetry-api >= 1.0 && < 1.1,
    memory >= 0.18 && < 0.19,
    scientific >= 0.3 && < 0.4,
    stm >= 2.5 && < 2.6,
    template-haskell >= 2.19 && < 2.24,
    text >= 2.0 && < 2.2,
    time >= 1.12 && < 1.15,
    unicode-transforms >= 0.4 && < 0.5,
    vector >= 0.13 && < 0.14,
    wireform-http,
    zlib >= 0.6 && < 0.8

executable example-lattice
  import: defaults
  hs-source-dirs: example
  main-is: Main.hs
  other-modules: StarWars
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    stm,
    text,
    time,
    wireform-http,
    wireform-lattice

executable example-sensors
  import: defaults
  hs-source-dirs: example
  main-is: SensorsMain.hs
  other-modules: SensorsPage
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    stm,
    template-haskell,
    text,
    time,
    wireform-http,
    wireform-lattice

executable example-auth
  import: defaults
  hs-source-dirs: example
  main-is: AuthMain.hs
  other-modules: AuthPage
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    stm,
    template-haskell,
    text,
    time,
    wireform-http,
    wireform-lattice

test-suite wireform-lattice-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Test.Lattice.Canonical
    Test.Lattice.Compat
    Test.Lattice.Compress
    Test.Lattice.Consistency
    Test.Lattice.Cursor
    Test.Lattice.Derived
    Test.Lattice.Digest
    Test.Lattice.DigestE2E
    Test.Lattice.E2E
    Test.Lattice.Feed
    Test.Lattice.Fixtures
    Test.Lattice.Fusion
    Test.Lattice.Gateway
    Test.Lattice.Governance
    Test.Lattice.IDL
    Test.Lattice.Live
    Test.Lattice.Loop
    Test.Lattice.Nodes
    Test.Lattice.Otel
    Test.Lattice.Plan
    Test.Lattice.Projection
    Test.Lattice.Query
    Test.Lattice.Registry
    Test.Lattice.Typed
    Test.Lattice.Value
    Test.Lattice.Verbs
    Test.Lattice.VerbsE2E
    Test.Lattice.Wire
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    aeson,
    base,
    bytestring,
    case-insensitive,
    containers,
    hedgehog >= 1.0 && < 1.8,
    network,
    scientific,
    stm,
    sydtest,
    sydtest-hedgehog,
    text,
    time,
    wireform-http,
    wireform-lattice
