cabal-version: 3.0
name: wireform-delta
version: 0.0.1.0
synopsis: Delta Lake transaction-log + Parquet reader (skeleton)
license: BSD-3-Clause
license-files: LICENSE, data/LICENSE-Spark, data/NOTICE-Spark
extra-source-files: data/spark-julian-gregorian-rebase-micros.json
author: Ian Duncan
maintainer: ian@iankduncan.com
copyright: 2026 Ian Duncan
build-type: Simple

common defaults
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -O2
  default-extensions:
    StrictData
    DerivingStrategies
    DeriveGeneric
    DeriveAnyClass
    OverloadedStrings
    LambdaCase

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Delta.Checkpoint
    Delta.DeletionVector
    Delta.IO
    Delta.Log
    Delta.Predicate
    Delta.Scan
  other-modules:
    Delta.CheckpointStats
    Delta.ParquetSchema
    Delta.Path
    Delta.ScanPredicate
    Delta.ScanSchema
    Delta.SparkCalendar
    Delta.Z85
  build-depends:
    base >= 4.20 && < 5,
    aeson >= 2.2 && < 2.4,
    bytestring >= 0.11 && < 0.13,
    containers >= 0.6 && < 0.9,
    crypton >= 2.2.6 && < 2.3,
    directory >= 1.3 && < 1.4,
    filepath  >= 1.4 && < 1.6,
    scientific >= 0.3 && < 0.4,
    template-haskell,
    text >= 2.0 && < 2.2,
    time >= 1.12 && < 1.16,
    unordered-containers >= 0.2.16 && < 0.3,
    vector >= 0.13 && < 0.14,
    vector-algorithms >= 0.9 && < 0.10,
    wireform-arrow,
    wireform-columnar-core,
    wireform-parquet

test-suite delta-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -O0
  build-depends:
    base >= 4.20 && < 5,
    aeson,
    bytestring,
    containers,
    directory,
    filepath,
    temporary,
    text,
    time,
    unordered-containers,
    vector,
    wireform-arrow,
    wireform-columnar-core,
    wireform-delta,
    wireform-parquet,
    sydtest

executable wireform-delta-interop-probe
  import: defaults
  hs-source-dirs: probe
  main-is: Probe.hs
  build-depends:
    base >= 4.20 && < 5,
    aeson >= 2.0 && < 2.4,
    bytestring,
    containers,
    directory >= 1.3 && < 1.4,
    filepath  >= 1.4 && < 1.6,
    text,
    vector,
    wireform-arrow,
    wireform-columnar-core,
    wireform-delta

benchmark delta-snapshot-bench
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is: Main.hs
  ghc-options: -rtsopts
  build-depends:
    base >= 4.20 && < 5,
    aeson,
    bytestring,
    containers,
    criterion >= 1.5 && < 1.7,
    deepseq,
    filepath,
    scientific,
    text,
    time,
    unordered-containers,
    vector,
    wireform-arrow,
    wireform-columnar-core,
    wireform-delta
