    "/catalog.v1.CatalogService/Watch": {
      "post": {
        "operationId": "CatalogService_Watch",
        "requestBody": {
          "content": {
            "application/connect+json": {
              "schema": {
                "$ref": "#/components/schemas/catalog.v1.WatchRequest",
                "x-connect-streaming": "bidi"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/connect+json": {
                "schema": {
