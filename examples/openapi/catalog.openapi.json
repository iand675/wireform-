{
  "components": {
    "schemas": {
      "catalog.v1.Category": {
        "description": "An enum → `{ \"type\": \"string\", \"enum\": [...] }` in declared order.",
        "enum": [
          "CATEGORY_UNSPECIFIED",
          "CATEGORY_BOOKS",
          "CATEGORY_ELECTRONICS",
          "CATEGORY_HOME"
        ],
        "type": "string"
      },
      "catalog.v1.CreateProductRequest": {
        "properties": {
          "attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Free-form attributes → JSON object with `additionalProperties`.",
            "type": "object"
          },
          "category": {
            "$ref": "#/components/schemas/catalog.v1.Category"
          },
          "name": {
            "description": "1..120 chars → `minLength` / `maxLength`.",
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "priceCents": {
            "description": "Non-negative price in minor units. int64 → JSON string; `gte` → `minimum`.",
            "format": "int64",
            "minimum": 0,
            "type": "string"
          },
          "slug": {
            "description": "A slug pattern → `pattern`.",
            "pattern": "^[a-z0-9-]+$",
            "type": "string"
          },
          "tags": {
            "description": "0..20 unique tags → `minItems` / `maxItems` / `uniqueItems`.",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "catalog.v1.GetProductRequest": {
        "properties": {
          "productId": {
            "description": "A UUID → JSON Schema `format: uuid`.",
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "catalog.v1.ImportSummary": {
        "properties": {
          "imported": {
            "format": "int32",
            "type": "integer"
          },
          "skipped": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "catalog.v1.LegacyTier": {
        "deprecated": true,
        "description": "A retired enum → `deprecated: true` on the enum component.",
        "enum": [
          "LEGACY_TIER_UNSPECIFIED",
          "LEGACY_TIER_GOLD"
        ],
        "type": "string"
      },
      "catalog.v1.ListProductsRequest": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/catalog.v1.Category"
          },
          "pageSize": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "catalog.v1.Product": {
        "properties": {
          "attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "category": {
            "$ref": "#/components/schemas/catalog.v1.Category"
          },
          "createdAt": {
            "description": "A well-known type → inlined as `{ \"type\": \"string\", \"format\": \"date-time\" }`.",
            "format": "date-time",
            "type": "string"
          },
          "dimensions": {
            "$ref": "#/components/schemas/catalog.v1.Product.Dimensions",
            "description": "A nested message → its own `#/components/schemas/...` entry."
          },
          "name": {
            "type": "string"
          },
          "priceCents": {
            "format": "int64",
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "sku": {
            "deprecated": true,
            "description": "A retired field → `deprecated: true` on the property.",
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "catalog.v1.Product.Dimensions": {
        "properties": {
          "depthCm": {
            "format": "double",
            "type": "number"
          },
          "heightCm": {
            "format": "double",
            "type": "number"
          },
          "widthCm": {
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "catalog.v1.ProductEvent": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/catalog.v1.ProductEvent.EventKind"
          },
          "product": {
            "$ref": "#/components/schemas/catalog.v1.Product"
          }
        },
        "type": "object"
      },
      "catalog.v1.ProductEvent.EventKind": {
        "enum": [
          "EVENT_KIND_UNSPECIFIED",
          "EVENT_KIND_CREATED",
          "EVENT_KIND_UPDATED",
          "EVENT_KIND_DELETED"
        ],
        "type": "string"
      },
      "catalog.v1.WatchRequest": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/catalog.v1.Category"
          },
          "productId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "connect.Error": {
        "description": "The Connect error envelope.",
        "properties": {
          "code": {
            "enum": [
              "canceled",
              "unknown",
              "invalid_argument",
              "deadline_exceeded",
              "not_found",
              "already_exists",
              "permission_denied",
              "resource_exhausted",
              "failed_precondition",
              "aborted",
              "out_of_range",
              "unimplemented",
              "internal",
              "unavailable",
              "data_loss",
              "unauthenticated"
            ],
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/connect.Error.Detail"
            },
            "type": "array"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "connect.Error.Detail": {
        "description": "A base64-encoded error detail (a protobuf Any).",
        "properties": {
          "debug": {},
          "type": {
            "type": "string"
          },
          "value": {
            "format": "byte",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Catalog API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/catalog.v1.CatalogService/CreateProduct": {
      "post": {
        "operationId": "CatalogService_CreateProduct",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/catalog.v1.CreateProductRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/catalog.v1.Product"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Unary write → POST only.",
        "tags": [
          "CatalogService"
        ]
      }
    },
    "/catalog.v1.CatalogService/GetProduct": {
      "get": {
        "operationId": "CatalogService_GetProduct_GET",
        "parameters": [
          {
            "description": "The base64url- or JSON-encoded request message.",
            "in": "query",
            "name": "message",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The message codec.",
            "in": "query",
            "name": "encoding",
            "required": true,
            "schema": {
              "enum": [
                "proto",
                "json"
              ],
              "type": "string"
            }
          },
          {
            "description": "1 if `message` is base64url-encoded.",
            "in": "query",
            "name": "base64",
            "required": false,
            "schema": {
              "enum": [
                "0",
                "1"
              ],
              "type": "string"
            }
          },
          {
            "description": "The message compression (e.g. gzip).",
            "in": "query",
            "name": "compression",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The Connect protocol version.",
            "in": "query",
            "name": "connect",
            "required": false,
            "schema": {
              "enum": [
                "v1"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/catalog.v1.Product"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Unary, side-effect-free → gets BOTH a POST and a cacheable GET operation.",
        "tags": [
          "CatalogService"
        ]
      },
      "post": {
        "operationId": "CatalogService_GetProduct",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/catalog.v1.GetProductRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/catalog.v1.Product"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Unary, side-effect-free → gets BOTH a POST and a cacheable GET operation.",
        "tags": [
          "CatalogService"
        ]
      }
    },
    "/catalog.v1.CatalogService/ImportProducts": {
      "post": {
        "operationId": "CatalogService_ImportProducts",
        "requestBody": {
          "content": {
            "application/connect+json": {
              "schema": {
                "$ref": "#/components/schemas/catalog.v1.CreateProductRequest",
                "x-connect-streaming": "client"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/connect+json": {
                "schema": {
                  "$ref": "#/components/schemas/catalog.v1.ImportSummary",
                  "x-connect-streaming": "client"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Client streaming → `x-connect-streaming: client`.",
        "tags": [
          "CatalogService"
        ]
      }
    },
    "/catalog.v1.CatalogService/ListProducts": {
      "post": {
        "operationId": "CatalogService_ListProducts",
        "requestBody": {
          "content": {
            "application/connect+json": {
              "schema": {
                "$ref": "#/components/schemas/catalog.v1.ListProductsRequest",
                "x-connect-streaming": "server"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/connect+json": {
                "schema": {
                  "$ref": "#/components/schemas/catalog.v1.Product",
                  "x-connect-streaming": "server"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Server streaming → `application/connect+json`, tagged `x-connect-streaming: server`.",
        "tags": [
          "CatalogService"
        ]
      }
    },
