cabal-version: 3.0
name: wireform-connect
version: 0.1.0.0
synopsis: Connect RPC protocol (connectrpc.com) client and server for Haskell
description:
  A native Haskell implementation of the Connect RPC protocol
  (<https://connectrpc.com/docs/protocol>): unary and all three streaming
  RPC kinds over HTTP\/1.1 and HTTP\/2, with binary Protobuf and JSON
  codecs, GET support for side-effect-free unary calls, identity\/gzip\/
  br\/zstd compression, the gRPC-derived error-code model, leading and
  trailing metadata, and the EndStreamResponse streaming envelope.
  .
  The Connect runtime reuses the existing @wireform-grpc@ \/ @grpc-spec@
  RPC abstraction wholesale: a generated Protobuf service (the
  @'Network.GRPC.Spec.Protobuf' serv \"meth\"@ tags that
  @'Network.GRPC.Protobuf.TH.loadProtoServices'@ emits for gRPC) drives
  Connect unchanged. Connect is purely a new transport over the same
  service description.

homepage: https://github.com/iand675/wireform-
bug-reports: https://github.com/iand675/wireform-/issues
license: BSD-3-Clause
license-file: LICENSE
author: Ian Duncan
maintainer: ian@iankduncan.com
copyright: 2026 Ian Duncan
category: Network, Web
build-type: Simple
tested-with: GHC == 9.6.4, GHC == 9.8.4

source-repository head
  type:     git
  location: https://github.com/iand675/wireform-

common defaults
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -O2
  default-extensions:
    StrictData
    DerivingStrategies
    DeriveGeneric
    DeriveAnyClass
    OverloadedStrings
    LambdaCase
    BangPatterns
    PatternSynonyms
    DataKinds
    TypeFamilies
    PolyKinds
    KindSignatures
    ScopedTypeVariables
    TypeApplications
    FlexibleContexts
    AllowAmbiguousTypes

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Network.Connect
    Network.Connect.Protocol
    Network.Connect.Error
    Network.Connect.Envelope
    Network.Connect.Metadata
    Network.Connect.Codec
    Network.Connect.Compression
    Network.Connect.Server
    Network.Connect.Client
  build-depends:
    base                 >= 4.16 && < 5,
    aeson                >= 2.1  && < 2.3,
    base64-bytestring    >= 1.2  && < 1.3,
    brotli               >= 0.0.0.3 && < 0.0.1,
    bytestring           >= 0.11 && < 0.13,
    case-insensitive     >= 1.2  && < 1.3,
    containers           >= 0.6  && < 0.9,
    mtl                  >= 2.2  && < 2.5,
    stm                  >= 2.5  && < 2.6,
    text                 >= 2.0  && < 2.2,
    transformers         >= 0.5  && < 0.7,
    unordered-containers >= 0.2  && < 0.3,
    vector               >= 0.13 && < 0.14,
    zlib                 >= 0.6  && < 0.8,
    zstd                 >= 0.1  && < 0.2,
    grpc-spec            >= 1.0  && < 1.1,
    wireform-http,
    wireform-proto

test-suite wireform-connect-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"
  default-extensions:
    DataKinds
    TemplateHaskell
    OverloadedStrings
  other-modules:
    Connect.TestProto
    Test.Protocol
    Test.Error
    Test.Envelope
    Test.Metadata
    Test.Compression
    Test.Loopback
    Test.Interop
  build-depends:
    base,
    aeson,
    base64-bytestring,
    bytestring,
    case-insensitive,
    containers,
    grpc-spec,
    hedgehog         >= 1.0  && < 1.8,
    network,
    scientific,
    text,
    transformers,
    unordered-containers,
    vector,
    wireform-connect,
    wireform-grpc,
    wireform-http,
    wireform-proto,
    zlib
