# Cabal builddirs: the default, plus every session/agent-private
# `--builddir=dist-<id>` (parallel subagents each build in their own).
dist-*/
dist-newstyle/
dist-derive/
dist-haddock/
dist-stats/
# Per-compiler builddirs for local cross-version testing (`cabal build
# --builddir=dist-ghcXY -w ghc-X.Y.Z all`). Auto-ignored so they don't
# leak into commits.
dist-ghc*/

# Stray criterion HTML reports from `cabal run wireform-fory:bench:... -- --output …`
# accidentally interpreted as a shell glob.
f-string
*-report.html
.cabal-sandbox/
cabal.sandbox.config
*.o
*.hi
*.dyn_o
*.dyn_hi
.ghc.environment.*
cabal.project.local
cabal.project.local.*
cabal.project.local~
__pycache__/
*.pyc
.direnv/
result
result-*

# Stray criterion output written to the repo root. Keep these
# scoped to the top level so test/fixture .csv / .html files in
# subdirectories aren't ignored by accident. If you actually want
# to commit benchmark output, put it under bench/ or docs/.
/*.csv
/*.tsv
/bench-*.html
/bench-*.json
# Scratch files created by the upstream conformance_test_runner.
nonexistent_tests.txt
failing_tests.txt
**/nonexistent_tests.txt
**/failing_tests.txt

wireform-yaml-bench.prof

# Autobahn|Testsuite report output (regenerated by
# wireform-websocket/scripts/run-autobahn.sh).
wireform-websocket/test-conformance/reports/

# Rust bench build artefacts.
wireform-websocket/bench-rust/target/

# bench artefacts: per-run html/json/csv reports stay local.
benchmark/results/
wireform-kafka/benchmark/results/
network-3.2.8.0/
flatparse-*/
bench-output.txt
traffic.html
